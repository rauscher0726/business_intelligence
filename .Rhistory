library(rvest)
base_url <- "https://isa401-salvage.vercel.app/exam/registry?start=1"
url    <- base_url
starts <- character()
pages  <- list()
repeat {
pg <- read_html(url)
pages[[length(pages) + 1]] <- pg
# record this page's start value ("none" for the first page if it has no ?start=)
s <- regmatches(url, regexpr("(?<=start=)[0-9]+", url, perl = TRUE))
starts <- c(starts, if (length(s)) s else "none")
# find the "Next" link; adjust the text if the site uses "›" or "Older" etc.
nxt <- html_element(pg, xpath = "//a[contains(normalize-space(.), 'Next')]")
if (is.na(nxt)) break
url <- url_absolute(html_attr(nxt, "href"), url)
Sys.sleep(1)  # be polite to the server
}
starts            # Q1: the start values across pages
length(pages)     # number of pages
# Option A: HTML table with a "Class" column
classes <- unlist(lapply(pages, function(pg) {
html_table(html_element(pg, "table"))$Class
}))
library(rvest)
base_url <- "https://isa401-salvage.vercel.app/exam/registry?start=1"
# 1. Visit every page by following the "Next" link
url    <- base_url
starts <- character()
pages  <- list()
repeat {
pg <- read_html(url)
pages[[length(pages) + 1]] <- pg
s <- regmatches(url, regexpr("(?<=start=)[0-9]+", url, perl = TRUE))
starts <- c(starts, if (length(s)) s else "none")
nxt <- html_element(pg, xpath = "//a[contains(normalize-space(.), 'Next')]")
if (is.na(nxt)) break
url <- url_absolute(html_attr(nxt, "href"), url)
Sys.sleep(1)
}
# 2. Pull the class of every wreck on every page into one vector
get_classes <- function(pg) {
tbl <- html_element(pg, "table")
if (!is.na(tbl)) {
# wrecks in an HTML table: take the "Class" column
html_table(tbl)$Class                               # <- CHECK column name
} else {
# wrecks as cards/list items: one element holds each class
html_text2(html_elements(pg, ".class"))             # <- CHECK selector
}
}
classes <- trimws(unlist(lapply(pages, get_classes)))
# 3. Checks
starts            # start values across pages
length(classes)   # number of wrecks; should match the total the site shows
table(classes)    # look for spelling variants before counting
