type_course = ellmer::type_object(
name = ellmer::type_string(
description = "Name of the course. For example, ISA 235. Information Technology and the Intelligent Enterprise. Do not include the parantheses for the credit hour and do not end with a period"
),
credit_hours = ellmer::type_integer(description = "Return the credit hours that are listed next to the course number and title in paranthesis. Please do not include the parantheses in your response"),
# Renamed description in desc to make it easier to see the description field from the element name (sublist name)
desc = ellmer::type_string(description = "The description of the course without the prereqs."),
preregs = ellmer::type_string("List the information after Prerequisite:")
)
isa_df = ellmer::parallel_chat_structured(
chat = chat, promts = course_list, type = type_course, include_tokens = T, include_cost = T
)
